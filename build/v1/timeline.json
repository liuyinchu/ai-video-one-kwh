      "title" : "灯亮之前，发生了什么？"
    },
    {
      "end" : 39.074671201814056,
      "scene" : 1,
      "start" : 19.518526077097505,
      "title" : "一度电，是多少？"
    },
    {
      "end" : 60.790272108843524,
      "scene" : 2,
      "start" : 39.074671201814056,
      "title" : "电从哪里来？"
    },
    {
      "end" : 82.29689342403626,
      "scene" : 3,
      "start" : 60.790272108843524,
      "title" : "它走的，是一张网"
    },
    {
      "end" : 104.80197278911561,
      "scene" : 4,
      "start" : 82.29689342403626,
      "title" : "为什么要先升高电压？"
    },
    {
      "end" : 126.33181405895688,
      "scene" : 5,
      "start" : 104.80197278911561,
      "title" : "少一点电流，少很多损耗"
    },
    {
      "end" : 150.06755102040816,
      "scene" : 6,
      "start" : 126.33181405895688,
      "title" : "来到城市，再逐级降压"
    },
    {
      "end" : 172.06179138321997,
      "scene" : 7,
      "start" : 150.06755102040816,
      "title" : "从小区，到你家的插座"
    },
    {
      "end" : 193.08079365079365,
      "scene" : 8,
      "start" : 172.06179138321997,
      "title" : "220 伏，也在不断变化"
    },
    {
      "end" : 215.79485260770974,
      "scene" : 9,
      "start" : 193.08079365079365,
      "title" : "电子，没有跑完这趟旅程"
    },
    {
      "end" : 237.02283446712016,
      "scene" : 10,
      "start" : 215.79485260770974,
      "title" : "最难的，是始终协调"
    },
    {
      "end" : 258.9583333333333,
      "scene" : 11,
      "start" : 237.02283446712016,
      "title" : "小小插座，连接整个系统"
    }
  ],
  "title" : "一度电如何来到插座",
